# Deadline Extractor configuration (all optional; prefix DE_)
# Directory with synthetic example documents shown in the UI picker.
DE_EXAMPLES_DIR=examples
DE_HOST=0.0.0.0
DE_PORT=8000

# Extraction engine. auto = Gemini when a key is set (rule-based fallback), rules = offline only,
# llm = Gemini only. Get a key at https://aistudio.google.com/apikey
DE_EXTRACTOR=auto
DE_GEMINI_API_KEY=
DE_GEMINI_MODEL=gemini-3.8-flash
